{
  "name": "medcalc-static",
  "private": true,
  "scripts": {
    "prepare": "node tools/install-hooks.mjs",
    "check:staged": "node tools/check-staged.mjs",
    "lint": "node tools/check-inline.mjs && eslint *.js tests tools eslint.config.mjs",
    "format:check": "prettier --check package.json eslint.config.mjs tests tools",
    "test": "node --test tests/*.test.mjs",
    "check:fast": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.2"
  }
}
